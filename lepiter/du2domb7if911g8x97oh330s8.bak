					"uidString" : "vqbOcSwKSfSfLs18UKT+mw=="
				},
				"code" : "BeamModuleResolution default"
			},
			{
				"__type" : "textSnippet",
				"children" : {
					"__type" : "snippets",
					"items" : [ ]
				},
