				"paragraphStyle" : {
					"__type" : "textStyle"
				},
				"string" : "GT renders inline method expanders (small triangle ▶ after a method send) using the {{gtClass:name=BrGlamorousTriangleExpanderTextAttribute}} framework. We reuse this for |> after each resolvable Elixir function call."
			},
			{
				"__type" : "textSnippet",
				"children" : {
					"__type" : "snippets",
					"items" : [ ]
				},
				"createEmail" : {
