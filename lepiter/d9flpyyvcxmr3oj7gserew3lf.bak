							},
							"paragraphStyle" : {
								"__type" : "textStyle"
							},
							"string" : "3. {{gtMethod:name=TElixirNavigationCoder>>detectElixirFunctionAt:ifFound:ifNone:}} extracts `(moduleName, functionName)` at the cursor."
						},
						{
							"__type" : "textSnippet",
