				"uid" : {
					"__type" : "uid",
					"uidString" : "S+IXjPPDS6YWXN8hk50Pig=="
				},
				"code" : "| n |\nn := BeamCompileFailureNotification new\n\tmoduleName: 'LocalUpload.EventStore.Event';\n\tsourcePath: 'lib/local_upload/event_store/event.ex';\n\tline: 105;\n\terrorMessage: 'unexpected reserved word: end';\n\tfunctionName: 'event_view';\n\tarity: 2;\n\tyourself.\nBeamCompileFailureNotificationElement new\n\tnotification: n;\n\tyourself",
