								"emailString" : "<unknown>"
							},
							"createTime" : {
								"__type" : "time",
								"time" : {
									"__type" : "dateAndTime",
									"dateAndTimeString" : "2026-05-06T20:00:00+08:00"
								}
							},
							"editEmail" : {
								"__type" : "email",
								"emailString" : "<unknown>"
							},
							"editTime" : {
								"__type" : "time",
								"time" : {
									"__type" : "dateAndTime",
									"dateAndTimeString" : "2026-05-06T20:00:00+08:00"
								}
							},
							"uid" : {
								"__type" : "uid",
								"uidString" : "2XnmiU0ndRdZ5z4HeWjF2g=="
							},
							"paragraphStyle" : {
								"__type" : "textStyle"
							},
							"string" : "Module-level errors (`use Some.Unloaded`, `nofile:1`) carry no usable line, so the bridge can't bracket against an enclosing function.  In that case the function falls back to whatever you were just editing in the function coder — saves from a function pane always focus on that function."
						}
					]
				},
				"createEmail" : {
					"__type" : "email",
					"emailString" : "<unknown>"
				},
				"createTime" : {
					"__type" : "time",
					"time" : {
						"__type" : "dateAndTime",
						"dateAndTimeString" : "2026-05-06T20:00:00+08:00"
					}
				},
				"editEmail" : {
					"__type" : "email",
					"emailString" : "<unknown>"
				},
				"editTime" : {
					"__type" : "time",
					"time" : {
						"__type" : "dateAndTime",
						"dateAndTimeString" : "2026-05-06T20:00:00+08:00"
					}
				},
				"uid" : {
					"__type" : "uid",
					"uidString" : "oWa4M20bUaACGNC5ygL3gQ=="
				},
				"paragraphStyle" : {
					"__type" : "textStyle"
				},
				"string" : "The function lookup is **three-tier**.  The bridge's own `#function`/`#arity` field on the error wins when set; otherwise we look up the error line against the cached function entries (handles parse failures where the AST returned empty); otherwise we fall back to a caller-supplied hint."
			},
			{
				"__type" : "textSnippet",
				"children" : {
